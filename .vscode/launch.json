{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ debug linux ARM",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/debug/N2Gateway",
            "args": ["/dev/ttyRS485"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}